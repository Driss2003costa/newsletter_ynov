# --- Base de données (SQLite via Prisma) ---
# Fichier local, créé automatiquement par `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# --- API TMDB (The Movie Database) ---
# Récupère une clé GRATUITE ici : https://www.themoviedb.org/settings/api
# Deux méthodes possibles, choisis-en UNE :
#
# 1) Clé API v3 (la plus simple) :
TMDB_API_KEY="colle_ta_cle_api_v3_ici"
#
# 2) OU jeton d'accès en lecture v4 (Bearer). Si défini, il est prioritaire :
# TMDB_ACCESS_TOKEN="colle_ton_read_access_token_v4_ici"
